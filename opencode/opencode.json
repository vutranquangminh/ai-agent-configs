  "provider": {
    "proxy-provider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Proxy Provider",
      "options": {
        "baseURL": "${PROVIDER_BASE_URL}",
        "apiKey": "${PROVIDER_API_KEY}"
      },
      "models": {
        "heavy-models": {
          "name": "heavy-models",
          "attachment": true,
          "tool_call": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text",
              "image"
            ]
          },
          "limit": {
            "context": 192000,
            "input": 192000,
            "output": 32000
          }
        },
        "heavy-flash-models": {
          "name": "heavy-flash-models",
          "attachment": true,
          "tool_call": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text",
              "image"
            ]
          },
          "limit": {
            "context": 192000,
            "input": 192000,
            "output": 32000
          }
        },
        "light-flash-models": {
          "name": "light-flash-models",
          "attachment": true,
          "tool_call": true,
          "limit": {
            "context": 192000,
            "input": 192000,
            "output": 32000
          }
        }
      }
    }
  },
  "mcp": {
    "sonarqube": {
      "type": "local",
      "command": [
        "zsh",
        "-c",
        "exec ~/.local/bin/sonarqube-mcp-ravid"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "enabled": true
    },
    "jira": {
      "type": "local",
      "command": [
        "zsh",
        "-c",
        "exec uvx mcp-atlassian --enabled-tools jira_search,jira_get_issue,jira_search_fields,jira_get_user_profile,jira_create_issue,jira_update_issue,jira_get_link_types,jira_create_issue_link,jira_add_comment"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project-from-cwd"
      ],
      "enabled": true
    }
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  }
}
