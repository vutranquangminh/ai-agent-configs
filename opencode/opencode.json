{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-acp@stable"
  ],
  "default_agent": "build",
  "compaction": {
    "auto": true,
    "threshold": 0.3,
    "strategy": "summarize",
    "preserveRecentMessages": 5
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "proxy-provider/heavy-flash-models",
      "description": "Build orchestrator for implementation, review, debugging, and final decisions.",
      "permission": {
        "task": {
          "*": "deny",
          "explore-lite": "allow",
          "explore-flash": "allow",
          "explore-heavy": "allow"
        }
      },
      "prompt": "Primary build orchestrator. Default to direct implementation. Fast-path known fixes without subagents. Ask only for product choices, security risks, or destructive actions. Do not narrate workflow. Subagents are read-only: default explore-flash; explore-lite for 1-2 symbol lookups; explore-heavy ONLY for architecture/security/root-cause. Never delegate mutations."
    },
    "plan": {
      "mode": "primary",
      "model": "proxy-provider/heavy-models",
      "description": "Plan orchestrator for planning, design, specs, review, debugging, and final decisions. When the current repo contains an openspec/ directory, follow its spec-driven workflow during planning (see repo AGENTS.md 'OPENSPEC WORKFLOW' section): check `openspec list` for an existing change, create a change only for new features, user-visible behavior changes, multi-app work, or DB migrations; skip specs for scoped bug fixes; after full implementation run `openspec archive <change-name>` and commit the archive.",
      "permission": {
        "task": {
          "*": "deny",
          "explore-lite": "allow",
          "explore-flash": "allow",
          "explore-heavy": "allow"
        }
      },
      "prompt": "Primary plan orchestrator. Planning, specs, and review only. Follow openspec/ when present. Do not implement unless requested. Subagents are read-only: default explore-flash; explore-lite for simple lookups; explore-heavy ONLY for architecture/security/root-cause. Never delegate mutations."
    },
    "explore-lite": {
      "mode": "subagent",
      "model": "proxy-provider/light-flash-models",
      "description": "Cheap/simple scoped lookups and easy read-only investigation. Follow the exact task from build or plan.",
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "**/secrets/**": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "codesearch": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "edit": "deny",
        "task": "deny",
        "todowrite": "deny",
        "question": "deny",
        "skill": "deny",
        "doom_loop": "deny",
        "external_directory": "ask",
        "bash": {
          "*": "deny",
          "pwd": "allow",
          "ls": "allow",
          "ls *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch": "allow",
          "git branch --show-current": "allow",
          "git branch --list*": "allow",
