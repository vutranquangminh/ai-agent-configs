# Hermes Environment Variables
# Copy this file to ~/.hermes/.env and fill in your values

# AI Provider Configuration
PROVIDER_BASE_URL=https://your-proxy-url.trycloudflare.com/v1
PROVIDER_API_KEY=your-api-key-here

# SonarQube MCP Server
SONARQUBE_URL=https://sonarqube.example.com
SONARQUBE_TOKEN=squ_xxx...

# Jira MCP Server
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your@email.com
JIRA_API_TOKEN=your-jira-api-token

# Discord Configuration (optional)
DISCORD_FREE_RESPONSE_CHANNELS=1536390401022238820
DISCORD_HOME_CHANNEL_ID=1536390401022238820
DISCORD_USER_ID=1017264752776462357
